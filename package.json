{
  "name": "starside-movers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Starside Movers — a 3D multiplayer moving-truck loading party game",
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite client",
    "build": "vite build client --outDir ../dist --emptyOutDir",
    "start": "node server/index.js",
    "test": "node --test --test-force-exit test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.30",
    "@colyseus/schema": "^5.0.52",
    "@colyseus/sdk": "^0.18.10",
    "@colyseus/ws-transport": "^0.18.5",
    "express": "^4.22.3",
    "pg": "^8.23.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14",
    "vite": "^8.3.8"
  }
}
