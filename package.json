{
  "name": "starside-movers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Starside Movers — a 3D multiplayer moving-truck loading party game",
  "scripts": {
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite client",
    "build": "vite build client --outDir ../dist --emptyOutDir",
    "start": "node server/index.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.5",
    "colyseus": "^0.16.5",
    "colyseus.js": "^0.16.22",
    "express": "^4.22.3",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "vite": "^8.3.8"
  }
}
